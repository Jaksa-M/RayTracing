#version 430 core

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout (rgba8, binding = 0) uniform image2D img;

uniform ivec2 resolution;

void main() {
    if (gl_GlobalInvocationID.x >= resolution.x || gl_GlobalInvocationID.y >= resolution.y) return;
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = pixel_coords / vec2(resolution);
    imageStore(img, pixel_coords, vec4(uv.x, uv.y, 0.0, 1.0)); // gradient
}
