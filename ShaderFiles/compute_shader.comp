#version 430 core
// inout is same as reference in cpp
// in is same as read only
// out means we can't read value that is inside, only write to it
// Matrices on GPU is stored as column-major, meaning when we are writing to mat[0] we are actually filling first column.

#extension GL_ARB_gpu_shader_int64 : require
#extension GL_ARB_bindless_texture : require

#define DEBUG_INSTANCE_ID 0
#define DEBUG_BLAS_ID 1
#define DEBUG_TRIANGLE_ID 2
#define DEBUG_ALBEDO 3
#define DEBUG_TRIANGLE_INDEX 4

// Global constants
const float FLOAT_MAX = 3.402823466e+38;
const float INFINITY_FLOAT = 1e30;
const float EPSILON = 1e-6;
const float PI = 3.14;
const uint INVALID_TEX = uint(-1); // invalid texture

// Struct types
struct Material {
    vec3 albedo;
    float roughness; // for metal (currently unused)
    vec3 emission;
    uint albedo_tex_index;
    uint roughness_tex_index; // for metal (currently unused)
    uint emission_tex_index;
    uint normal_map_tex_index;
    uint unused1;
};

struct Ray {
    vec3 ro;
    float tMin;
    vec3 rd;
    float tMax;
};
void ray_struct_init(inout Ray ray){ // acts as it's constructor
    ray.tMin = 0;
    ray.tMax = FLOAT_MAX;
}

struct HitRecord {
    vec3 p;
    float t;
    vec3 normal;
    uint instance_index;
    Material mat;
    vec2 buv;
    uint triangle_index;
};
void hit_struct_init(inout HitRecord h){ // acts as it's constructor
    h.t = FLOAT_MAX;
    h.triangle_index = uint(-1);
}

struct IntersectResult {
    float t;
    vec2 buv; // barycentric uv (beta, gamma)
    uint closest_tri_index; // index into index buffer
};

void intersectResultInit(out IntersectResult res) {
    res.t = FLOAT_MAX;
    res.buv = vec2(0.0);
    res.closest_tri_index = uint(-1);
}

struct MeshDesc {
    uint vertex_offset; // position where vertices array is placed
    uint normal_offset; // position where normals array is placed
    uint uv_offset; // position where uv's array is placed
    uint col_offset; // position where color array is placed
    uint index_offset; // position where indices array is placed

    uint vertices_count; // how many vertices there are
    uint indices_count; // how many indices there are
};

struct GPUMeshInstance {
    vec4 local_to_world_row_0;
    vec4 local_to_world_row_1;
    vec4 local_to_world_row_2;
    uint mesh_index; // index into MeshDesc array
    uint material_index; // index into Materials array
    uint blas_offset;
    uint blas_size;
};

struct GPUBLASNode {
    vec3 aabb_min;
    uint left_child;
    vec3 aabb_max;
    uint right_child;
    uint first_triangle_index, triangle_cnt;
    uint unused1, unused2;
};
bool isLeaf(in GPUBLASNode node) {
    return node.triangle_cnt > 0u;
}

struct GPUTLASNode {
    vec3 aabb_min;
    uint left_right; // 2x16 bits for left and right child index
    vec3 aabb_max;
    uint blas; // Valid only for leaf nodes
};
bool isTLASLeaf(in GPUTLASNode node) {
    return node.left_right == 0u;
}

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout (rgba8, binding = 0) uniform image2D u_display_img;
layout (binding = 1) uniform sampler2D u_background_img;
layout (rgba32f, binding = 2) uniform image2D u_accumulated_img;

layout(std430, binding = 3) buffer MeshData { float u_mesh_data[]; };
layout(std430, binding = 4) buffer MeshDescs { MeshDesc u_mesh_descs[]; };
layout(std430, binding = 5) buffer MeshInstances { GPUMeshInstance u_instances[]; };
layout(std430, binding = 6) buffer Materials { Material u_materials[]; };
layout(std430, binding = 7) readonly buffer ssbo3 { sampler2D textures[]; };
layout(std430, binding = 8) readonly buffer BLASNodes { GPUBLASNode u_blas_nodes[]; };
layout(std430, binding = 9) readonly buffer TLASNodes { GPUTLASNode u_tlas_nodes[]; };


uniform ivec2 u_resolution; // (width, height)

uniform vec3 u_cam_center;
uniform vec3 u_pixel00_loc;
uniform vec3 u_pixel_delta_u;
uniform vec3 u_pixel_delta_v;

uniform uint u_frame_index; // count of how many frames have passed since start of program
uniform float u_environment_light;
uniform int u_max_bounces;
uniform int u_spp;
uniform bool u_accumulate; // on CPU this is called camera_moved
uniform uint u_instance_count; // number of mesh descriptors

// Random number generator related functions
uint randPcg(inout uint rng_state) {
    uint state = rng_state;
    rng_state = rng_state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float randUniform(inout uint rng_state) {
    // lower 8 bits are just noice (coming from precision loss).
    // So we shift those lower 8 bits, and than divide by rest 2^24 (since we are left with 24 bits).
    return float(randPcg(rng_state) >> 8u) * (1.0 / 16777216.0);
}
vec3 randomVec3(inout uint rng_state) { // always return in range [0,1].
    // If we need in a different range, we can convert on the place where it is needed.
    return vec3(
        randUniform(rng_state),
        randUniform(rng_state),
        randUniform(rng_state)
    );
}
vec3 randomUnitVector(inout uint rng_state) {
    while (true) {
        vec3 p = randomVec3(rng_state) * 2.0 - 1.0;
        float lensq = dot(p, p);
        if (lensq > 1e-160 && lensq <= 1.0) {
            return p / sqrt(lensq);
        }
    }
}

// Utility functions
float atan2(float y, float x) {
    float s = abs(x) > abs(y) ? 1.0 : 0.0;
    return mix(PI / 2.0 - atan(x, y), atan(y, x), s);
}

// Function that inverts the vec3 in a safe way (avoiding division by 0)
float invertCoord(float x) {
    if (abs(x) > 1e-12) return 1.0 / x;
    else return (x >= 0.0) ? FLOAT_MAX : -FLOAT_MAX;
}

// Safe inversion of a vec3
vec3 invertVecSafe(vec3 v) {
    return vec3(invertCoord(v.x), invertCoord(v.y), invertCoord(v.z));
}

// The name comes from the equirectangular projection (also called lat-long mapping), which is a very common way of mapping
// a 3D direction vector onto a 2D texture.
vec2 directionToEquirecangularUV(in vec3 rd){
    float u = (atan2(-rd.z, rd.x) + PI) / (2 * PI);
    float v = acos(-rd.y) / PI;
    return vec2(u, v);
}

void getRay(float i, float j, vec2 offset, out Ray ray) {
    // Construct a camera ray originating from the origin and directed at randomly sampled point around the pixel location i, j.
    // Jitter is the process of selecting random offsets inside the pixel. 
    vec3 pixel_sample = u_pixel00_loc
        + ((i + offset.x) * u_pixel_delta_u)
        + ((j + offset.y) * u_pixel_delta_v);

    ray.ro = u_cam_center;
    ray.rd = normalize(pixel_sample - ray.ro);
}

vec3 transformPointAffine(vec3 pos, mat4 m) {
    return (m * vec4(pos, 1.0)).xyz;
}

vec3 transformDirection(vec3 dir, mat3 m) {
    vec3 transformed_dir = m * dir;
    return normalize(transformed_dir);
}

vec3 barycentricInterpolate(vec3 v0, vec3 v1, vec3 v2, vec2 buv) {
    float w = 1.0 - buv.x - buv.y;
    return v0 * w + v1 * buv.x + v2 * buv.y;
}

vec2 barycentricInterpolate(vec2 v0, vec2 v1, vec2 v2, vec2 buv) {
    float w = 1.0 - buv.x - buv.y;
    return v0 * w + v1 * buv.x + v2 * buv.y;
}

mat4 buildLocalToWorldMatrix(in GPUMeshInstance instance) {
    mat4 local_to_world;
    local_to_world[0] = vec4(instance.local_to_world_row_0.x, instance.local_to_world_row_1.x, instance.local_to_world_row_2.x, 0.0);
    local_to_world[1] = vec4(instance.local_to_world_row_0.y, instance.local_to_world_row_1.y, instance.local_to_world_row_2.y, 0.0);
    local_to_world[2] = vec4(instance.local_to_world_row_0.z, instance.local_to_world_row_1.z, instance.local_to_world_row_2.z, 0.0);
    local_to_world[3] = vec4(instance.local_to_world_row_0.w, instance.local_to_world_row_1.w, instance.local_to_world_row_2.w, 1.0);

    return local_to_world;
}

vec3 fibonacci3d(uint n) {
    const float g = 1.22074408460575947536;
    const float a1 = 1.0 / g;
    const float a2 = 1.0 / (g * g);
    const float a3 = 1.0 / (g * g * g);
    return vec3(fract(0.5 + a1 * n), fract(0.5 + a2 * n), fract(0.5 + a3 * n));
}

// Utility functions for meshes
uvec3 getIndices(MeshDesc desc, uint tri_index) {
    uint base = desc.index_offset + tri_index;

    uint i0 = floatBitsToUint(u_mesh_data[base + 0u]);
    uint i1 = floatBitsToUint(u_mesh_data[base + 1u]);
    uint i2 = floatBitsToUint(u_mesh_data[base + 2u]);

    return uvec3(i0, i1, i2);
}

void getVertices(MeshDesc desc, uvec3 idx, out vec3 v0, out vec3 v1, out vec3 v2) {
    uint base0 = desc.vertex_offset + idx.x * 3u;
    uint base1 = desc.vertex_offset + idx.y * 3u;
    uint base2 = desc.vertex_offset + idx.z * 3u;

    v0 = vec3(u_mesh_data[base0 + 0u], u_mesh_data[base0 + 1u], u_mesh_data[base0 + 2u]);
    v1 = vec3(u_mesh_data[base1 + 0u], u_mesh_data[base1 + 1u], u_mesh_data[base1 + 2u]);
    v2 = vec3(u_mesh_data[base2 + 0u], u_mesh_data[base2 + 1u], u_mesh_data[base2 + 2u]);
}

void getNormals(MeshDesc desc, uvec3 idx, out vec3 n0, out vec3 n1, out vec3 n2) {
    uint base0 = desc.normal_offset + idx.x * 3u;
    uint base1 = desc.normal_offset + idx.y * 3u;
    uint base2 = desc.normal_offset + idx.z * 3u;

    n0 = vec3(u_mesh_data[base0 + 0u], u_mesh_data[base0 + 1u], u_mesh_data[base0 + 2u]);
    n1 = vec3(u_mesh_data[base1 + 0u], u_mesh_data[base1 + 1u], u_mesh_data[base1 + 2u]);
    n2 = vec3(u_mesh_data[base2 + 0u], u_mesh_data[base2 + 1u], u_mesh_data[base2 + 2u]);
}

void getUVs(MeshDesc desc, uvec3 idx, out vec2 uv0, out vec2 uv1, out vec2 uv2) {
    uint base0 = desc.uv_offset + idx.x * 2u;
    uint base1 = desc.uv_offset + idx.y * 2u;
    uint base2 = desc.uv_offset + idx.z * 2u;

    uv0 = vec2(u_mesh_data[base0 + 0u], u_mesh_data[base0 + 1u]);
    uv1 = vec2(u_mesh_data[base1 + 0u], u_mesh_data[base1 + 1u]);
    uv2 = vec2(u_mesh_data[base2 + 0u], u_mesh_data[base2 + 1u]);
}

// Material utility functions
vec3 sampleTexture(uint tex_index, in vec3 flat_material, in HitRecord rec, int mode) {
    // mode: 0 = RGB (vec3), 1 = R channel (float)
    // if albedo texture is present, use it. Otherwise use mat.albedo.
    // If roughness texture is present, sample its R channel. Otherwise use mat.roughness.
    // If emissive texture is present, use it. Otherwise use mat.emission.
    if (tex_index != INVALID_TEX) {
        // get UV's from triangle that is hit and interpolate it
        GPUMeshInstance inst = u_instances[rec.instance_index];
        MeshDesc desc = u_mesh_descs[inst.mesh_index];
        uvec3 idxs = getIndices(desc, rec.triangle_index);

        vec2 uv0, uv1, uv2;
        getUVs(desc, idxs, uv0, uv1, uv2);
        vec2 uv = barycentricInterpolate(uv0, uv1, uv2, rec.buv);

        vec3 texel = texture(textures[tex_index], uv).rgb;

        if (mode == 0) return texel;  // RGB case
        if (mode == 1) return vec3(texel.r, texel.r, texel.r); // R only
    }
    return flat_material;
}

vec3 sampleAlbedo(inout Material mat, inout HitRecord rec) {
    return sampleTexture(mat.albedo_tex_index, mat.albedo, rec, 0);
}

float sampleRoughness(inout Material mat, inout HitRecord rec) {
    return sampleTexture(mat.roughness_tex_index, vec3(mat.roughness), rec, 1).r;
}

vec3 sampleEmission(inout Material mat, inout HitRecord rec) {
    return sampleTexture(mat.emission_tex_index, mat.emission, rec, 0);
}

vec3 applyNormalMap(in Material mat, in HitRecord rec) {
    if (mat.normal_map_tex_index == INVALID_TEX) {
        return rec.normal;
    }

    GPUMeshInstance inst = u_instances[rec.instance_index];
    MeshDesc desc = u_mesh_descs[inst.mesh_index];
    uvec3 idxs = getIndices(desc, rec.triangle_index);

    // Get vertex positions (local) and transform to world space
    vec3 lv0, lv1, lv2;
    getVertices(desc, idxs, lv0, lv1, lv2);

    mat4 local_to_world = buildLocalToWorldMatrix(inst);

    vec3 v0w = transformPointAffine(lv0, local_to_world);
    vec3 v1w = transformPointAffine(lv1, local_to_world);
    vec3 v2w = transformPointAffine(lv2, local_to_world);

    // Get per-vertex UVs
    vec2 uv0, uv1, uv2;
    getUVs(desc, idxs, uv0, uv1, uv2);

    // Tangent and bitangent calculation
    vec2 delta_uv1 = uv1 - uv0;
    vec2 delta_uv2 = uv2 - uv0;
    vec3 delta_pos1 = v1w - v0w;
    vec3 delta_pos2 = v2w - v0w;

    float denom = delta_uv1.x * delta_uv2.y - delta_uv1.y * delta_uv2.x;
    float r = (abs(denom) < EPSILON) ? 1.0 : (1.0 / denom); // preventing division by zero

    vec3 tangent = r * (delta_pos1 * delta_uv2.y - delta_pos2 * delta_uv1.y);
    tangent = normalize(tangent);
    vec3 bitangent = normalize(cross(rec.normal, tangent));

    // Interpolate UV to get sample coords
    vec2 uv = barycentricInterpolate(uv0, uv1, uv2, rec.buv);

    // Sample normal map (assumed in tangent space, stored in [0,1])
    vec3 nmap = texture(textures[mat.normal_map_tex_index], uv).rgb;
    vec3 tangent_normal = normalize(2.0 * nmap - vec3(1.0)); // [0,1] -> [-1,1]

    // Build TBN: columns are tangent, bitangent, normal
    mat3 TBN = mat3(tangent, bitangent, rec.normal);
    vec3 shading_normal = normalize(TBN * tangent_normal);
    return shading_normal;
}

vec3 emitted(in HitRecord h) {
    return sampleEmission(h.mat, h);
}

bool scatterLambertian(inout uint rng_state, in HitRecord rec, out vec3 attenuation, out vec3 new_dir) {
    // If triangle_index invalid (ray didn't hit mesh), use standard approach
    if (rec.triangle_index == uint(-1)) {
        vec3 scatter_direction = normalize(rec.normal + randomUnitVector(rng_state));
        if (length(scatter_direction) < EPSILON) scatter_direction = rec.normal;
        new_dir = scatter_direction;
        attenuation = rec.mat.albedo;
        return true;
    }

    vec3 albedo = sampleAlbedo(rec.mat, rec);
    //float roughness = sampleRoughness(rec.mat, rec);

    // Compute normal -> apply normal map if exists
    vec3 final_normal = applyNormalMap(rec.mat, rec);
    if (any(isnan(final_normal))) final_normal = rec.normal;
    final_normal = normalize(final_normal);

    vec3 scatter_direction = normalize(final_normal + randomUnitVector(rng_state));
    if (length(scatter_direction) < EPSILON) scatter_direction = final_normal;
    new_dir = scatter_direction;

    attenuation = albedo;
    return true;
}

bool intersectTriangleMT(Ray ray, vec3 v0, vec3 v1, vec3 v2, out float t, out float u, out float v) {
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 p  = cross(ray.rd, e2);
    float det = dot(e1, p);
    if (abs(det) < EPSILON) return false;
    float invDet = 1.0 / det;
    vec3 s = ray.ro - v0;
    u = invDet * dot(s, p);
    
    if (u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, e1);
    v = invDet * dot(ray.rd, q);
    
    if (v < 0.0 || u + v > 1.0) return false;

    float tt = invDet * dot(e2, q);
    if (tt < 0.001 || tt < ray.tMin || tt > ray.tMax) return false;

    t = tt;
    return true;
}

void getInstanceWorldAABB(in GPUMeshInstance inst, out vec3 aabb_min_ws, out vec3 aabb_max_ws) {
    // root node (AABB in local space)
    GPUBLASNode root = u_blas_nodes[inst.blas_offset];

    mat4 local_to_world = buildLocalToWorldMatrix(inst);

    // Transform all 8 corners to world space to get the full world AABB
    vec3 local_min = root.aabb_min;
    vec3 local_max = root.aabb_max;
    vec3 corners[8] = vec3[8](
        vec3(local_min.x, local_min.y, local_min.z),
        vec3(local_max.x, local_min.y, local_min.z),
        vec3(local_min.x, local_max.y, local_min.z),
        vec3(local_max.x, local_max.y, local_min.z),
        vec3(local_min.x, local_min.y, local_max.z),
        vec3(local_max.x, local_min.y, local_max.z),
        vec3(local_min.x, local_max.y, local_max.z),
        vec3(local_max.x, local_max.y, local_max.z)
    );

    aabb_min_ws = vec3( 1e30 );
    aabb_max_ws = vec3(-1e30);
    for (int i = 0; i < 8; i++) {
        vec3 p = transformPointAffine(corners[i], local_to_world);
        aabb_min_ws = min(aabb_min_ws, p);
        aabb_max_ws = max(aabb_max_ws, p);
    }
}
bool intersectAABB(
    in vec3 ro, in vec3 rd, in vec3 inv_dir,
    in vec3 aabb_min_ws, in vec3 aabb_max_ws,
    in float tmax,
    out float t_hit)
{
    vec3 t1 = (aabb_min_ws - ro) * inv_dir;
    vec3 t2 = (aabb_max_ws - ro) * inv_dir;

    vec3 tmin3 = min(t1, t2);
    vec3 tmax3 = max(t1, t2);

    float tmin = max( max(tmin3.x, tmin3.y), max(tmin3.z, 0.0) );
    float tmax_ = min( min(tmax3.x, tmax3.y), min(tmax3.z, tmax) );

    t_hit = tmin;
    return tmax_ >= tmin;
}

void slabTestTwoTLASNodes(
    in vec3 inv_dir, in float ray_tmax,
    in vec3 n1_min, in vec3 n1_max,
    in vec3 n2_min, in vec3 n2_max,
    in float rox, in float roy, in float roz,
    in bvec3 signMask,
    out bool hit1, out float d1,
    out bool hit2, out float d2
) {
    // Node 1
    float tx_min1 = ((signMask.x ? n1_min.x : n1_max.x) * inv_dir.x) - rox;
    float tx_max1 = ((signMask.x ? n1_max.x : n1_min.x) * inv_dir.x) - rox;
    float ty_min1 = ((signMask.y ? n1_min.y : n1_max.y) * inv_dir.y) - roy;
    float ty_max1 = ((signMask.y ? n1_max.y : n1_min.y) * inv_dir.y) - roy;
    float tz_min1 = ((signMask.z ? n1_min.z : n1_max.z) * inv_dir.z) - roz;
    float tz_max1 = ((signMask.z ? n1_max.z : n1_min.z) * inv_dir.z) - roz;

    float tmin1 = max(max(tx_min1, ty_min1), max(tz_min1, 0.0));
    float tmax1 = min(min(tx_max1, ty_max1), min(tz_max1, ray_tmax));
    hit1 = (tmax1 >= tmin1) && (tmin1 < ray_tmax) && (tmax1 > 0.0);
    d1 = hit1 ? tmin1 : 1e30;

    // Node 2
    float tx_min2 = ((signMask.x ? n2_min.x : n2_max.x) * inv_dir.x) - rox;
    float tx_max2 = ((signMask.x ? n2_max.x : n2_min.x) * inv_dir.x) - rox;
    float ty_min2 = ((signMask.y ? n2_min.y : n2_max.y) * inv_dir.y) - roy;
    float ty_max2 = ((signMask.y ? n2_max.y : n2_min.y) * inv_dir.y) - roy;
    float tz_min2 = ((signMask.z ? n2_min.z : n2_max.z) * inv_dir.z) - roz;
    float tz_max2 = ((signMask.z ? n2_max.z : n2_min.z) * inv_dir.z) - roz;

    float tmin2 = max(max(tx_min2, ty_min2), max(tz_min2, 0.0));
    float tmax2 = min(min(tx_max2, ty_max2), min(tz_max2, ray_tmax));
    hit2 = (tmax2 >= tmin2) && (tmin2 < ray_tmax) && (tmax2 > 0.0);
    d2 = hit2 ? tmin2 : 1e30;
}

void slabTestTwoNodes1(
    vec3 inv_dir, float ray_tmax,
    vec3 node1_min, vec3 node1_max,
    vec3 node2_min, vec3 node2_max,
    float rox, float roy, float roz,
    bvec3 signMask,
    out float d1, out float d2
) {
    // Node 1
    float tx_min1 = ((signMask.x ? node1_min.x : node1_max.x) * inv_dir.x) - rox;
    float tx_max1 = ((signMask.x ? node1_max.x : node1_min.x) * inv_dir.x) - rox;
    float ty_min1 = ((signMask.y ? node1_min.y : node1_max.y) * inv_dir.y) - roy;
    float ty_max1 = ((signMask.y ? node1_max.y : node1_min.y) * inv_dir.y) - roy;
    float tz_min1 = ((signMask.z ? node1_min.z : node1_max.z) * inv_dir.z) - roz;
    float tz_max1 = ((signMask.z ? node1_max.z : node1_min.z) * inv_dir.z) - roz;

    float tmin1 = max(max(tx_min1, ty_min1), max(tz_min1, 0.0));
    float tmax1 = min(min(tx_max1, ty_max1), min(tz_max1, ray_tmax));
    d1 = (tmax1 >= tmin1) ? tmin1 : 1e30;

    // Node 2
    float tx_min2 = ((signMask.x ? node2_min.x : node2_max.x) * inv_dir.x) - rox;
    float tx_max2 = ((signMask.x ? node2_max.x : node2_min.x) * inv_dir.x) - rox;
    float ty_min2 = ((signMask.y ? node2_min.y : node2_max.y) * inv_dir.y) - roy;
    float ty_max2 = ((signMask.y ? node2_max.y : node2_min.y) * inv_dir.y) - roy;
    float tz_min2 = ((signMask.z ? node2_min.z : node2_max.z) * inv_dir.z) - roz;
    float tz_max2 = ((signMask.z ? node2_max.z : node2_min.z) * inv_dir.z) - roz;

    float tmin2 = max(max(tx_min2, ty_min2), max(tz_min2, 0.0));
    float tmax2 = min(min(tx_max2, ty_max2), min(tz_max2, ray_tmax));
    d2 = (tmax2 >= tmin2) ? tmin2 : 1e30;
}

void slabTestTwoNodes(
    in vec3 inv_dir, in float ray_tmax,
    in vec3 node1_min,  in vec3 node1_max,
    in vec3 node2_min,  in vec3 node2_max,
    in float rox, in float roy, in float roz,
    in bvec3 signMask,
    out bool hit1, out float dist1,
    out bool hit2, out float dist2
) {
    // Node 1
    float tx_min1 = ((signMask.x ? node1_min.x : node1_max.x) * inv_dir.x) - rox;
    float tx_max1 = ((signMask.x ? node1_max.x : node1_min.x) * inv_dir.x) - rox;

    float ty_min1 = ((signMask.y ? node1_min.y : node1_max.y) * inv_dir.y) - roy;
    float ty_max1 = ((signMask.y ? node1_max.y : node1_min.y) * inv_dir.y) - roy;

    float tz_min1 = ((signMask.z ? node1_min.z : node1_max.z) * inv_dir.z) - roz;
    float tz_max1 = ((signMask.z ? node1_max.z : node1_min.z) * inv_dir.z) - roz;

    float tmin1 = max(max(tx_min1, ty_min1), max(tz_min1, 0.0));
    float tmax1 = min(min(tx_max1, ty_max1), min(tz_max1, ray_tmax));

    hit1 = (tmax1 >= tmin1) && (tmax1 > 0.0) && (tmin1 < ray_tmax);
    dist1 = hit1 ? tmin1 : FLOAT_MAX;

    // Node 2
    float tx_min2 = ((signMask.x ? node2_min.x : node2_max.x) * inv_dir.x) - rox;
    float tx_max2 = ((signMask.x ? node2_max.x : node2_min.x) * inv_dir.x) - rox;

    float ty_min2 = ((signMask.y ? node2_min.y : node2_max.y) * inv_dir.y) - roy;
    float ty_max2 = ((signMask.y ? node2_max.y : node2_min.y) * inv_dir.y) - roy;

    float tz_min2 = ((signMask.z ? node2_min.z : node2_max.z) * inv_dir.z) - roz;
    float tz_max2 = ((signMask.z ? node2_max.z : node2_min.z) * inv_dir.z) - roz;

    float tmin2 = max(max(tx_min2, ty_min2), max(tz_min2, 0.0));
    float tmax2 = min(min(tx_max2, ty_max2), min(tz_max2, ray_tmax));

    hit2 = (tmax2 >= tmin2) && (tmax2 > 0.0) && (tmin2 < ray_tmax);
    dist2 = hit2 ? tmin2 : FLOAT_MAX;
}

bool intersectBLAS( in Ray local_ray, in MeshDesc desc, in uint blas_offset, out float best_t,
    out uint best_index_offset, out float best_u, out float best_v) 
{
    const uint MAX_STACK_SIZE = 64u;
    uint node_stack[MAX_STACK_SIZE];
    uint stack_top = 0u;

    node_stack[stack_top++] = 0u; // root node index

    // Initialize best intersection data
    best_index_offset = uint(-1); // Invalid triangle
    best_u = 0.0;
    best_v = 0.0;

    // Precompute ray inverse direction and sign mask for faster AABB tests
    vec3 inv_dir = vec3(1.0) / local_ray.rd;
    float rox = local_ray.ro.x * inv_dir.x;
    float roy = local_ray.ro.y * inv_dir.y;
    float roz = local_ray.ro.z * inv_dir.z;

    // sign_mask tells whether each direction component is positive or negative
    // (used to decide which slab planes to use for min/max)
    bvec3 sign_mask = bvec3(local_ray.rd.x >= 0.0, local_ray.rd.y >= 0.0, local_ray.rd.z >= 0.0);

    while (stack_top > 0u) {
        uint node_local_idx = node_stack[--stack_top];
        uint node_abs_idx = blas_offset + node_local_idx;
        GPUBLASNode node = u_blas_nodes[node_abs_idx];

        if (isLeaf(node)) {
            // Loop through all triangles in this leaf
            for (uint i = 0u; i < node.triangle_cnt; i++) {
                uint tri_base = node.first_triangle_index * 3u + i * 3u;
                
                uvec3 idxs = getIndices(desc, tri_base);
                vec3 v0, v1, v2;
                getVertices(desc, idxs, v0, v1, v2);

                // ray-triangle intersection
                float t, u, v;
                if (intersectTriangleMT(local_ray, v0, v1, v2, t, u, v)) {
                    // If the intersection is valid and closer than the current best
                    if (t > 0.0 && t < best_t) {
                        best_t = t;
                        best_index_offset = tri_base;
                        best_u = u;
                        best_v = v;
                    }
                }
            }
            continue;
        }

        uint left_local = node.left_child;
        uint right_local = node.right_child;

        // Fetch the child nodes
        GPUBLASNode node_left = u_blas_nodes[blas_offset + left_local];
        GPUBLASNode node_right = u_blas_nodes[blas_offset + right_local];

        float dist_left = FLOAT_MAX;
        float dist_right = FLOAT_MAX;
        // slabTestTwoNodes(inv_dir, local_ray.tMax,
        //                  node_left.aabb_min, node_left.aabb_max,
        //                  node_right.aabb_min, node_right.aabb_max,
        //                  rox, roy, roz, sign_mask,
        //                  dist_left, dist_right);

        bool hitL, hitR;
        slabTestTwoNodes(
            inv_dir, local_ray.tMax,
            node_left.aabb_min, node_left.aabb_max,
            node_right.aabb_min, node_right.aabb_max,
            rox, roy, roz, sign_mask,
            hitL, dist_left,
            hitR, dist_right
        );


        bool left_check = dist_left < best_t;
        bool right_check = dist_right < best_t;

        // Sort children based on distance to prioritize closer node
        if (dist_right < dist_left) {
            uint temp_local = left_local; left_local = right_local; right_local = temp_local;
            bool temp_check = left_check; left_check = right_check; right_check = temp_check;
            float temp_dist = dist_left; dist_left = dist_right; dist_right = temp_dist;
            GPUBLASNode temp_node = node_left; node_left = node_right; node_right = temp_node;
        }

        // push further child first (so closer child gets popped first)
        if (right_check && dist_right < best_t && stack_top < MAX_STACK_SIZE) {
            node_stack[stack_top++] = right_local;
        }
        if (left_check && dist_left < best_t && stack_top < MAX_STACK_SIZE) {
            node_stack[stack_top++] = left_local;
        }
    }

    return (best_index_offset != uint(-1) && best_t < FLOAT_MAX);
}

bool hitMesh(in Ray world_ray, in MeshDesc desc, out HitRecord out_hit, in GPUMeshInstance instance) {
    if (desc.indices_count < 3u || desc.vertices_count == 0u) return false;

    mat4 local_to_world = buildLocalToWorldMatrix(instance);
    mat4 world_to_local = inverse(local_to_world);

    // Transform ray into local space
    Ray local_ray;
    local_ray.ro = transformPointAffine(world_ray.ro, world_to_local);
    local_ray.rd = transformDirection(world_ray.rd, mat3(world_to_local));

    // Convert ray bounds to local space (same as your previous code)
    vec3 pmin_world = world_ray.ro + world_ray.rd * world_ray.tMin;
    vec3 pmax_world = world_ray.ro + world_ray.rd * world_ray.tMax;
    vec3 pmin_local = transformPointAffine(pmin_world, world_to_local);
    vec3 pmax_local = transformPointAffine(pmax_world, world_to_local);

    float local_min = length(local_ray.ro - pmin_local);
    float local_max = length(local_ray.ro - pmax_local);
    local_ray.tMin = min(local_min, local_max);
    local_ray.tMax = max(local_min, local_max);

    float best_t = FLOAT_MAX;
    uint best_index_offset = uint(-1);
    float best_u = 0.0;
    float best_v = 0.0;

    bool hit = intersectBLAS(local_ray, desc, instance.blas_offset, best_t, best_index_offset, best_u, best_v);
    if (!hit) return false;

    // Build local hit record
    HitRecord local_hit;
    hit_struct_init(local_hit);
    local_hit.t = best_t;
    local_hit.p = local_ray.ro + best_t * local_ray.rd;
    local_hit.triangle_index = best_index_offset;

    // Fetch triangle vertices (local)
    uvec3 best_idxs = getIndices(desc, best_index_offset);
    vec3 lv0, lv1, lv2;
    getVertices(desc, best_idxs, lv0, lv1, lv2);

    vec3 geomN_local = normalize(cross(lv1 - lv0, lv2 - lv0));
    if (dot(geomN_local, local_ray.rd) > 0.0) geomN_local = -geomN_local;
    local_hit.normal = geomN_local;
    local_hit.buv = vec2(best_u, best_v);

    // Transform to world space
    vec3 p_world = transformPointAffine(local_hit.p, local_to_world);
    mat3 normal_mat = transpose(inverse(mat3(local_to_world)));
    vec3 n_world = normalize(normal_mat * local_hit.normal);

    float t_world = length(world_ray.ro - p_world);

    out_hit = local_hit;
    out_hit.p = p_world;
    out_hit.normal = n_world;
    out_hit.t = t_world;

    if (any(isnan(out_hit.normal)) || any(isnan(out_hit.p)) || !(out_hit.t > 0.0)) return false;

    return true;
}

bool intersectTLAS(in Ray ray, inout float closest_t, out HitRecord best_hit) {
    hit_struct_init(best_hit); // it is out variable and it should be initalized here.

    const uint MAX_STACK = 64u;
    uint stack[MAX_STACK];
    uint stack_ptr = 0u;

    stack[stack_ptr++] = 0u; // TLAS root is node 0

    vec3 inv_dir = invertVecSafe(ray.rd);
    float rox = ray.ro.x * inv_dir.x;
    float roy = ray.ro.y * inv_dir.y;
    float roz = ray.ro.z * inv_dir.z;
    bvec3 signMask = bvec3(inv_dir.x >= 0.0, inv_dir.y >= 0.0, inv_dir.z >= 0.0);

    bool hit_anything = false;

    while (stack_ptr > 0u) {
        uint node_idx = stack[--stack_ptr];
        GPUTLASNode node = u_tlas_nodes[node_idx];

        // Quick rejection of whole node
        float tx_min = ((signMask.x ? node.aabb_min.x : node.aabb_max.x) * inv_dir.x) - rox;
        float tx_max = ((signMask.x ? node.aabb_max.x : node.aabb_min.x) * inv_dir.x) - rox;
        float ty_min = ((signMask.y ? node.aabb_min.y : node.aabb_max.y) * inv_dir.y) - roy;
        float ty_max = ((signMask.y ? node.aabb_max.y : node.aabb_min.y) * inv_dir.y) - roy;
        float tz_min = ((signMask.z ? node.aabb_min.z : node.aabb_max.z) * inv_dir.z) - roz;
        float tz_max = ((signMask.z ? node.aabb_max.z : node.aabb_min.z) * inv_dir.z) - roz;

        float tmin = tx_min > ty_min ? tx_min : ty_min;
        if (tz_min > tmin) tmin = tz_min;

        float tmax = tx_max < ty_max ? tx_max : ty_max;
        if (tz_max < tmax) tmax = tz_max;

        if ((tmin > tmax) || (tmax < 0.0) || (tmin > closest_t)) continue; // miss node entirely

        if (isTLASLeaf(node)) {
            uint instance_idx = node.blas;

            // Limit ray tMax is set to current closest_t (so hitMesh can early out)
            Ray limited_ray = ray; // world space
            limited_ray.tMax = closest_t;

            GPUMeshInstance inst = u_instances[instance_idx];
            MeshDesc desc = u_mesh_descs[inst.mesh_index];

            HitRecord world_hit;
            hit_struct_init(world_hit);

            // We pass limited_ray so hitMesh / intersectBLAS can cull with closest_t.
            if (hitMesh(limited_ray, desc, world_hit, inst)) {
                if (world_hit.t < closest_t && world_hit.t > 0.0) {
                    best_hit = world_hit;
                    best_hit.instance_index = instance_idx;
                    best_hit.mat = u_materials[inst.material_index];
                    closest_t = world_hit.t;
                    hit_anything = true;
                }
            }
            continue;
        }

        // Internal node -> push children in distance order
        uint left = node.left_right & 0xFFFFu;
        uint right = (node.left_right >> 16) & 0xFFFFu;

        GPUTLASNode leftNode = u_tlas_nodes[left];
        GPUTLASNode rightNode = u_tlas_nodes[right];

        bool hit_left; float dist_left;
        bool hit_right; float dist_right;
        // slabTestTwoTLASNodes(
        //     inv_dir, closest_t,
        //     leftNode.aabb_min, leftNode.aabb_max,
        //     rightNode.aabb_min, rightNode.aabb_max,
        //     rox, roy, roz, signMask,
        //     hit_left, dist_left, hit_right, dist_right
        // );
        slabTestTwoNodes(
            inv_dir, closest_t,
            leftNode.aabb_min, leftNode.aabb_max,
            rightNode.aabb_min, rightNode.aabb_max,
            rox, roy, roz, signMask,
            hit_left, dist_left,
            hit_right, dist_right
        );


        if (hit_left && hit_right) {
            stack[stack_ptr++] = (dist_left < dist_right) ? right : left;
            stack[stack_ptr++] = (dist_left < dist_right) ? left : right;
        }
        else if (hit_left) {
            stack[stack_ptr++] = left;
        }
        else if (hit_right) {
            stack[stack_ptr++] = right;
        }
    } // while loop end

    return hit_anything;
}

bool hitScene(inout Ray ray, inout HitRecord closest_hit) {
    float closest_t = ray.tMax; // intersectTLAS will update closest_t as it finds hits.
    HitRecord best;

    bool hit = intersectTLAS(ray, closest_t, best);
    if (!hit) return false;

    closest_hit = best;
    return true;
}

bool hitSceneOld(inout Ray ray, inout HitRecord closest_hit) {
    float closest_t = FLOAT_MAX;
    uint closest_instance = uint(-1);

    for (uint m = 0u; m < u_instance_count; m++) {
        GPUMeshInstance inst = u_instances[m];

        // AABB intersection in world space
        vec3 aabb_min_ws, aabb_max_ws;
        getInstanceWorldAABB(inst, aabb_min_ws, aabb_max_ws);

        vec3 inv_dir = 1.0 / ray.rd;
        float t_aabb;
        bool hit_aabb = intersectAABB(ray.ro, ray.rd, inv_dir, aabb_min_ws, aabb_max_ws, ray.tMax, t_aabb);

        if (!hit_aabb || t_aabb > closest_t) continue; // Skip far or missed AABBs

        MeshDesc desc = u_mesh_descs[inst.mesh_index];
        Material mat = u_materials[inst.material_index];

        // Limit the ray range to current closest hit
        Ray limited_ray = ray;
        limited_ray.tMax = closest_t; 

        HitRecord mh;
        hit_struct_init(mh);

        if (hitMesh(limited_ray, desc, mh, inst) && mh.t < closest_t) {
            closest_hit = mh;
            closest_hit.mat = mat;
            closest_hit.instance_index = m;
            closest_t = mh.t;
            closest_instance = m;
        }
    }

    return closest_t < FLOAT_MAX;
}

vec3 getDebug (inout Ray ray, uint debug_mode) {
    HitRecord h;
    hit_struct_init(h);

    if (hitScene(ray, h)) {
        switch (debug_mode) {
            case DEBUG_INSTANCE_ID:
                return fibonacci3d(h.instance_index);
                break;
            case DEBUG_BLAS_ID:
                //return fibonacci3d(h.blas_id);
                break;
            case DEBUG_TRIANGLE_ID:
                //return fibonacci3d(h.triangle_index);
                break;
            case DEBUG_ALBEDO:
                return h.mat.albedo;
                break;
            case DEBUG_TRIANGLE_INDEX:
                return fibonacci3d(h.triangle_index); 
                break;
        }
    }
    return vec3(1,0,1);
}

vec3 tracePathDebug(inout Ray ray, inout uint rng_state) {
    vec3 result = vec3(0.0, 0.0, 0.0);
    vec3 attenuation = vec3(1.0);

    return result = getDebug(ray, DEBUG_INSTANCE_ID);
}

vec3 tracePath(inout Ray ray, inout uint rng_state) {
    vec3 result = vec3(0.0, 0.0, 0.0);
    vec3 attenuation = vec3(1.0);

    for (uint depth = 0; depth <= u_max_bounces; depth++) { // max bounces
        HitRecord h;
        hit_struct_init(h);

        if(!hitScene(ray, h)){
            // background
            vec2 uv = directionToEquirecangularUV(ray.rd);
            vec3 bg = texture(u_background_img, vec2(uv.x, 1-uv.y)).rgb;
            result += attenuation * bg;
            break;
        }

        vec3 new_dir;
        vec3 new_attenuation;

        vec3 color_from_emission = emitted(h);
        result += attenuation * color_from_emission;

        scatterLambertian(rng_state, h, new_attenuation, new_dir);

        attenuation *= new_attenuation;
        ray.ro = h.p + h.normal * 0.0001; // offset to avoid self-hit
        ray.rd = new_dir;
    }
    
    return result;
}


void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= u_resolution.x || gid.y >= u_resolution.y) return;

    uint rng_state = uint(gid.x) + uint(gid.y) * uint(u_resolution.x) + u_frame_index * uint(u_resolution.x) * uint(u_resolution.y);

    float i = float(gid.x) + 0.5;
    float j = float(gid.y) + 0.5;
    vec3 pixel_pos = u_pixel00_loc + i * u_pixel_delta_u + j * u_pixel_delta_v;

    vec3 color = vec3(0.0);
    for(uint samp = 0; samp < u_spp; samp++){
        // Vector to a random point in the [-.5,-.5]-[+.5,+.5] unit square.
        vec2 offset = vec2(randUniform(rng_state) - 0.5, randUniform(rng_state) - 0.5);

        Ray ray;
        ray_struct_init(ray);
        getRay(float(gid.x), float(gid.y), offset, ray);

        color += tracePath(ray, rng_state);
    }
    color /= u_spp;

    // Load previous accumulation
    vec4 prev_accum = imageLoad(u_accumulated_img, gid);

    // Extract sum and count
    vec3 accum_sum = prev_accum.rgb;
    uint count = floatBitsToUint(prev_accum.a);

    // If camera moved, reset accumulation
    if (u_accumulate) {
        accum_sum = color; // start new sum
        count = 1u; // reset accumulated frame counter
    }
    else {
        accum_sum += color;
        count += 1u; // increment accumulated frame counter
    }

    // Compute average
    vec3 avg_color = accum_sum / float(count);

    // Store back into accumulation buffer
    imageStore(u_accumulated_img, gid, vec4(accum_sum, uintBitsToFloat(count)));

    // Display final averaged color
    imageStore(u_display_img, gid, vec4(avg_color, 1.0));
}
