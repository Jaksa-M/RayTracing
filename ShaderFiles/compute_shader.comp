#version 430 core
 // inout is same as reference in cpp
 // in is same as read only
 // out means we can't read value that is inside, only write to it

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout (rgba8, binding = 0) uniform image2D img;
layout (binding = 1) uniform sampler2D background_img;
layout (rgba8, binding = 2) uniform image2D display_img;
layout (rgba32f, binding = 3) uniform image2D accumulated_img;

uniform ivec2 resolution; // (width, height)

uniform vec3 cam_center;
uniform vec3 pixel00_loc;
uniform vec3 pixel_delta_u;
uniform vec3 pixel_delta_v;

uniform float trace_percentage;
uniform uint frame_index; // count of how many frames have passed since start of program
uniform float environment_light;
uniform int reflection_depth;
uniform int spp;

// Global constants
const float FLOAT_MAX = 3.402823466e+38;
const float EPSILON = 1e-8;
const float PI = 3.14;

// Struct types
struct Material {
    vec3 albedo;
    float roughness; // for metal (currently unused)
    vec3 emission;
};

struct Hit {
    float t;
    vec3 p;
    vec3 normal;
    Material mat;
    bool hit;
};
void hit_struct_init(inout Hit h){ // acts as it's constructor
    h.t = FLOAT_MAX;
    h.hit = false;
}

// Random number generator related functions
uint rand_pcg(inout uint rng_state) {
    uint state = rng_state;
    rng_state = rng_state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}
float rand_uniform(inout uint rng_state) {
    return float(rand_pcg(rng_state)) * (1.0 / 4294967296.0); // divide by 2^32
}
vec3 random_vec3(inout uint rng_state, float minVal, float maxVal) { // random vector in [-1,1]
    return vec3(
        minVal + (maxVal - minVal) * rand_uniform(rng_state),
        minVal + (maxVal - minVal) * rand_uniform(rng_state),
        minVal + (maxVal - minVal) * rand_uniform(rng_state)
    );
}
vec3 random_unit_vector(inout uint rng_state) {
    while (true) {
        vec3 p = random_vec3(rng_state, -1.0, 1.0);
        float lensq = dot(p, p);
        if (lensq > 1e-160 && lensq <= 1.0) {
            return p / sqrt(lensq);
        }
    }
}

// Utility functions
void writeColor(ivec2 pix, vec3 rgb) {
    imageStore(img, pix, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}

float atan2(float y, float x) {
    float s = abs(x) > abs(y) ? 1.0 : 0.0;
    return mix(PI / 2.0 - atan(x, y), atan(y, x), s);
}

vec2 sampleSquare(inout uint rng_state) {
    // Returns the vector to a random point in the [-.5,-.5]-[+.5,+.5] unit square.
    return vec2(rand_uniform(rng_state) - 0.5, rand_uniform(rng_state) - 0.5);
}

void getRay(float i, float j, vec2 offset, out vec3 ro, out vec3 rd) {
    // Construct a camera ray originating from the origin and directed at randomly sampled point around the pixel location i, j.
    // Jitter is the process of selecting random offsets inside the pixel. 
    vec3 pixel_sample = pixel00_loc
        + ((i + offset.x) * pixel_delta_u)
        + ((j + offset.y) * pixel_delta_v);

    ro = cam_center;
    rd = normalize(pixel_sample - ro);
}


// Material utility functions
vec3 emitted(in Hit h) {
    return h.mat.emission;
}

bool scatterLambertian(inout uint rng_state, vec3 ro, vec3 rd, Hit rec, out vec3 attenuation, out vec3 new_dir) {
    vec3 scatter_direction = normalize(rec.normal + random_unit_vector(rng_state));

    if (length(scatter_direction) < EPSILON) scatter_direction = rec.normal;
    new_dir = scatter_direction;
    attenuation = rec.mat.albedo;
    return true;
}

// Hit Object functions
bool hitRectangle(in vec3 rect_p1, in vec3 rect_p2, in vec3 rect_p3, in vec3 rect_p4, in Material mat, in vec3 ro, in vec3 rd, out Hit h) {
    //rect_p1 - bottom-left, rect_p2 - bottom-right, rect_p3 - top-right, rect_p4 - top-left

    vec3 rectangle_normal = normalize(cross(rect_p2 - rect_p1, rect_p3 - rect_p1));

    float c = dot(rectangle_normal, rect_p1);
    float denominator = dot(rectangle_normal, rd);
    if (abs(denominator) < EPSILON) return false;

    float t = (c - dot(rectangle_normal, ro)) / denominator;
    if (t < 0.001) return false;

    vec3 Q = ro + t * rd;
    if (dot(cross((rect_p2 - rect_p1), (Q - rect_p1)), rectangle_normal) < 0 ||
        dot(cross((rect_p3 - rect_p2), (Q - rect_p2)), rectangle_normal) < 0 ||
        dot(cross((rect_p4 - rect_p3), (Q - rect_p3)), rectangle_normal) < 0 ||
        dot(cross((rect_p1 - rect_p4), (Q - rect_p4)), rectangle_normal) < 0) {
        return false;
    }

    h.t = t;
    h.p = Q; // hit point

    vec3 N = normalize(rectangle_normal);
    if (dot(N, rd) > 0.0) N = -N;
    h.normal = N;
    h.mat.albedo = mat.albedo;
    h.mat.emission = mat.emission;
    h.hit = true;
    return true;
}

bool hitTriangle(in vec3 tri_v0, in vec3 tri_v1, in vec3 tri_v2, in Material mat, in vec3 ro, in vec3 rd, out Hit h) {
    // Moeller Trumbore

    vec3 edge1 = tri_v1 - tri_v0;
    vec3 edge2 = tri_v2 - tri_v0;

    vec3 p  = cross(rd, edge2);
    float det = dot(edge1, p);

    if (abs(det) < EPSILON) return false;

    float inv_det = 1.0 / det;
    vec3 s = ro - tri_v0;
    float u = inv_det * dot(s, p);

    if (u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, edge1);
    float v = inv_det * dot(rd, q);

    if (v < 0.0 || u + v > 1.0) return false;

    float t = inv_det * dot(edge2, q);
    if (t < 0.001) return false;

    h.t = t;
    h.p = ro + t * rd; // hit point

    vec3 N = normalize(cross(edge1, edge2));
    if (dot(N, rd) > 0.0) N = -N;
    h.normal = N;
    h.mat.albedo = mat.albedo;
    h.mat.emission = mat.emission;
    h.hit = true;
    return true;
}

bool hitSphere(in vec3 sph_center, in float sph_radius, in Material mat, in vec3 ro, in vec3 rd, out Hit h) {
    vec3 oc = sph_center - ro;
    float a = dot(rd, rd);
    float b = dot(rd, oc);
    float c = dot(oc, oc) - sph_radius * sph_radius;
    float discriminant = b*b - a*c;
    if (discriminant < 0.0) return false;

    float sqrtd = sqrt(discriminant);
    float t = (b - sqrtd) / a;
    if (t < 0.001) { 
        t = (b + sqrtd) / a;
        if (t < 0.001) return false;
    }

    vec3 P = ro + t * rd;
    vec3 N = normalize((P - sph_center) / sph_radius);
    if (dot(N, rd) > 0.0) N = -N;

    h.t = t;
    h.p = P; // hit point
    h.normal = N;
    h.mat.albedo = mat.albedo;
    h.mat.emission = mat.emission;
    h.hit = true;
    return true;
}

bool hitScene(vec3 ro, vec3 rd, inout Hit closest_hit) {
    // Materials
    Material red;   red.albedo = vec3(0.65, 0.05, 0.05); red.emission = vec3(0.0);
    Material green; green.albedo = vec3(0.12, 0.45, 0.15); green.emission = vec3(0.0);
    Material white; white.albedo = vec3(0.73); white.emission = vec3(0.0);
    Material light; light.albedo = vec3(0.0); light.emission = vec3(15.0); // strong emission

    Hit tmp;
    hit_struct_init(tmp);
    // Left wall (red)
    if (hitRectangle(vec3(-1,-1,-5), vec3(-1,-1,-3), vec3(-1,1,-3), vec3(-1,1,-5), red, ro, rd, tmp) && tmp.t < closest_hit.t) closest_hit = tmp;
    // Right wall (green)
    if (hitRectangle(vec3(1,-1,-3), vec3(1,-1,-5), vec3(1,1,-5), vec3(1,1,-3), green, ro, rd, tmp) && tmp.t < closest_hit.t) closest_hit = tmp;
    // Floor (white)
    if (hitRectangle(vec3(-1,-1,-5), vec3(1,-1,-5), vec3(1,-1,-3), vec3(-1,-1,-3), white, ro, rd, tmp) && tmp.t < closest_hit.t) closest_hit = tmp;
    // Ceiling (white)
    if (hitRectangle(vec3(-1,1,-5), vec3(-1,1,-3), vec3(1,1,-3), vec3(1,1,-5), white, ro, rd, tmp) && tmp.t < closest_hit.t) closest_hit = tmp;
    // Back wall (white)
    if (hitRectangle(vec3(-1,-1,-5), vec3(-1,1,-5), vec3(1,1,-5), vec3(1,-1,-5), white, ro, rd, tmp) && tmp.t < closest_hit.t) closest_hit = tmp;

    // Light on ceiling
    if (hitRectangle(vec3(-0.25,0.999,-4.25), vec3(0.25,0.999,-4.25), vec3(0.25,0.999,-3.75), vec3(-0.25,0.999,-3.75), light, ro, rd, tmp) && tmp.t < closest_hit.t) {
        closest_hit = tmp;
    }

    // Spheres
    if (hitSphere(vec3(-0.5, -0.6, -4.0), 0.4, white, ro, rd, tmp) && tmp.t < closest_hit.t) closest_hit = tmp; // big white sphere near back

    if (hitSphere(vec3(0.5, -0.8, -3.5), 0.2, red, ro, rd, tmp) && tmp.t < closest_hit.t) closest_hit = tmp; // smaller red sphere in front

    return closest_hit.hit;
}

vec3 rayColor(vec3 ro, vec3 rd, inout uint rng_state) {
    vec3 result = vec3(0.0, 0.0, 0.0);
    vec3 attenuation = vec3(1.0);

    for (uint depth = 0; depth < reflection_depth; depth++) { // max bounces
        Hit h;
        hit_struct_init(h);

        if(!hitScene(ro, rd, h)){
            // background
            float u = (atan2(-rd.z, rd.x) + PI) / (2 * PI);
            float v = acos(-rd.y) / PI;
            vec3 bg = texture(background_img, vec2(u, 1-v)).rgb;
            result += attenuation * bg;
            break;
        }

        vec3 new_dir;
        vec3 new_attenuation;

        vec3 color_from_emission = emitted(h);
        result += attenuation * color_from_emission;

        scatterLambertian(rng_state, ro, rd, h, new_attenuation, new_dir);

        attenuation *= new_attenuation;
        ro = h.p + h.normal * 0.0001; // offset to avoid self-hit
        rd = new_dir;
    }
    
    return result;
}


void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= resolution.x || gid.y >= resolution.y) return;

    uint rng_state = uint(gid.x) + uint(gid.y) * uint(resolution.x) + frame_index * uint(resolution.x) * uint(resolution.y);

    float i = float(gid.x) + 0.5;
    float j = float(gid.y) + 0.5;
    vec3 pixel_pos = pixel00_loc + i * pixel_delta_u + j * pixel_delta_v;

    // vec3 ro = cam_center;
    // vec3 rd = normalize(pixel_pos - ro);

    vec3 color = vec3(0.0);
    for(uint samp = 0; samp < spp; samp++){
        vec2 offset = sampleSquare(rng_state);

        vec3 ro, rd;
        getRay(float(gid.x), float(gid.y), offset, ro, rd);

        color += rayColor(ro, rd, rng_state);
    }
    color /= spp;
    writeColor(gid, color);
}
